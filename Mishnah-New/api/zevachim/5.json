       "text": "\n",
       "marker": null
      },
      {
       "text": "שחיטתן בכל מקום בעזרה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ודמן טעון מתנה אחת",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ובלבד שיתן כנגד היסוד",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "שנה באכילתן",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "הבכור נאכל לכהנים",
