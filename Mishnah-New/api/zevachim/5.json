      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "והמעשר לכל אדם",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ונאכלין בכל העיר (לכל אדם) בכל מאכל",
       "marker": null
      },
