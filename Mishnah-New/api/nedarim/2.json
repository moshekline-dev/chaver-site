       "mishnah_num_he": "הרי"
      },
      {
       "label": "C",
       "text": "הרי עלי כמעשר\nאם כמעשר בהמה נדר אסור ואם שלגרן מתר \nואם סתם אסור",
       "markers": [
        {
         "type": "internalparallel",
         "text": "ואם סתם אסור"
        }
