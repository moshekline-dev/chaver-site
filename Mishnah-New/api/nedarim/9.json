      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "קצרה והרי היא ארכה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "מתר בה לא מפני שהיא",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "כעורה ונעשית נאה שחורה ונעשית לבנה קצרה ונעשית ארכה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "אלא שהנדר טעות",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ומעשה באחד שנדר מבת אחותו הניה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "והכניסוה לבית רבי ישמעאל ויפוה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "אמר לו רבי ישמעאל בני לזו נדרת",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "אמר לו לאו והתירו רבי ישמעאל",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "באותה שעה בכה רבי ישמעאל ואמר",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בנות ישראל נאות הן אלא שהעניות מנולתן",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "וכשמת רבי ישמעאל היו בנות ישראל נושאות קינה ואומרות",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בנות ישראל אל רבי ישמעאל בכינה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "וכן הוא אומר בשאול בנות ישראל אל שאול בכינה",
       "marker": null
      }
     ],
