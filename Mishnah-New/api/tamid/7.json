       "text": "(ד) ",
       "marker": null
      },
      {
       "text": "השיר",
       "marker": "horizontal3"
      },
      {
       "text": " שהיו הלוים ",
       "marker": null
      },
      {
       "text": "אומרים במקדש",
       "marker": "vertical1"
      },
      {
       "text": "\n",
       "marker": "vertical1"
      },
      {
       "text": "ביום הראשון היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "לה' הארץ ומלואה תבל ויושבי בה",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בשני היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "גדול ה' ומהלל מאד בעיר אלהינו הר קדשו",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בשלישי היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "אלהים נצב בעדת אל בקרב אלהים ישפט",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ברביעי היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "אל נקמות ה' אל נקמות הופיע וגו'",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בחמישי היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "הרנינו לאלהים עזנו הריעו לאלהי יעקב",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בששי היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ה' מלך גאות לבש וגו'",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "בשבת היו אומרים",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "מזמור שיר ליום השבת",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "מזמור שיר לעתיד לבא",
       "marker": null
      },
      {
       "text": "\n",
       "marker": null
      },
      {
       "text": "ליום שכלו שבת מנוחה לחיי העולמים",
       "marker": null
      }
